<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/widget_root" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background"
    android:paddingStart="14dp" android:paddingEnd="14dp"
    android:paddingTop="11dp" android:paddingBottom="10dp">
    <!-- A one-line header leaves more space for the year image on small widgets. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:singleLine="true" android:ellipsize="end" android:text="EveryDayTa"
            android:textSize="15sp" android:textColor="#133D39" android:textStyle="bold"/>
        <TextView android:id="@+id/widget_summary" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="2026 · 0 days" android:singleLine="true" android:ellipsize="end"
            android:textSize="10sp" android:textColor="#6B817A"/>
        <TextView android:id="@+id/widget_prev" android:layout_width="32dp"
            android:layout_height="36dp" android:gravity="center"
            android:text="‹" android:textColor="#176B60" android:textSize="26sp"
            android:contentDescription="Previous month" android:visibility="gone"/>
        <TextView android:id="@+id/widget_next" android:layout_width="32dp"
            android:layout_height="36dp" android:gravity="center"
            android:text="›" android:textColor="#176B60" android:textSize="26sp"
            android:contentDescription="Next month" android:visibility="gone"/>
    </LinearLayout>
    <ImageView android:id="@+id/widget_image" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="5dp" android:contentDescription="Tracker year heatmap"
        android:scaleType="fitCenter"/>
</LinearLayout>
